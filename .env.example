# English Mastery — environment variables
# Copy to .env.local. Only VITE_* variables are exposed to the browser.
# NEVER put secrets (service role key, AI provider keys) in VITE_* variables.

# Supabase (Phase 2). Leave empty to run in local/guest mode.
# Dashboard → Connect → Framework. Use the *publishable* key (sb_publishable_…),
# which is safe in the browser because Row Level Security protects the data.
# Never use the secret key (sb_secret_…) or the legacy service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
